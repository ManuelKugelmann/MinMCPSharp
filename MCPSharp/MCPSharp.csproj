<Project Sdk="Microsoft.NET.Sdk">

  <!-- Default (Debug/Release): multi-target -->
  <PropertyGroup Condition="'$(Configuration)' != 'Unity'">
    <TargetFrameworks>netstandard2.0;net8.0;net9.0</TargetFrameworks>
  </PropertyGroup>

  <!-- Unity: netstandard2.0 only, with Unity define -->
  <PropertyGroup Condition="'$(Configuration)' == 'Unity'">
    <TargetFramework>netstandard2.0</TargetFramework>
    <DefineConstants>$(DefineConstants);UNITY_5_3_OR_NEWER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>13.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <!-- Package Metadata -->
    <PackageId>MCPSharp</PackageId>
    <Version>1.0.0</Version>
    <Authors>Allen Frise</Authors>
    <Title>MCPSharp - Model Context Protocol for .NET</Title>
    <Description>Lightweight MCP server for .NET and Unity. Attribute-based API, HTTP and stdio transports, zero heavy dependencies.</Description>
    <PackageTags>mcp;mcpsharp;ai;json-rpc;tools;model-context-protocol;server;unity</PackageTags>
    <RepositoryUrl>https://github.com/manuelkugelmann/mcpsharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageProjectUrl>https://github.com/manuelkugelmann/mcpsharp</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MCPSharp.Test" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="PolySharp" Version="1.15.0" Condition="!$(DefineConstants.Contains('UNITY_5_3_OR_NEWER'))">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

  <!-- Compile-time-only reference to UnityEngine stubs for Unity config -->
  <ItemGroup Condition="'$(Configuration)' == 'Unity'">
    <ProjectReference Include="..\UnityEngine.Stubs\UnityEngine.Stubs.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
