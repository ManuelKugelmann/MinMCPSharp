<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0</TargetFrameworks>
    <LangVersion>13.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <!-- Package Metadata -->
    <PackageId>MinMCPSharp</PackageId>
    <Version>1.0.0</Version>
    <Authors>Allen Frise</Authors>
    <Title>MinMCPSharp - Model Context Protocol for .NET</Title>
    <Description>Lightweight MCP server for .NET and Unity. Attribute-based API, HTTP and stdio transports, zero heavy dependencies.</Description>
    <PackageTags>mcp;minmcpsharp;ai;json-rpc;tools;model-context-protocol;server;unity</PackageTags>
    <RepositoryUrl>https://github.com/manuelkugelmann/minmcpsharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageProjectUrl>https://github.com/manuelkugelmann/minmcpsharp</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MinMCPSharp.Test" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Exclude Unity drop-in scripts from library compilation -->
  <ItemGroup>
    <Compile Remove="Unity\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="PolySharp" Version="1.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

</Project>
